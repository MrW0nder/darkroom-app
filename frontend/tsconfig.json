{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "Node",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* React-specific settings */
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    /* Node.js type compatibility */
    "types": ["node"],                      // Includes Node.js type declarations to support fs, path, etc.

    /* Output options */
    "outDir": "./dist"                       // Ensures compiled output goes to the dist directory
  },
  "include": ["src/**/*"],                   // Includes all .ts and .tsx files in src and its subdirectories
  "exclude": ["node_modules", "dist"]        // Excludes node_modules and output directory
}